# .env (Ejemplo para desarrollo local)
DJANGO_SETTINGS_MODULE=core.settings.local
DJANGO_SECRET_KEY=clave-super-secreta-local

# PostgreSQL Local (Docker o Instalación Nativa)
DB_NAME=email_db_local
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Configuración SMTP de Google
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=xxxxxxx@xxail.com
EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxx # Pegar los 16 caracteres sin espacios
DEFAULT_FROM_EMAIL=Email Service <xxxxxx@xxail.com>
EMAIL_BACKEND = 'django.core.mail.backends.smtp.EmailBackend'
