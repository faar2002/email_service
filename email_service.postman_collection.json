{
  "info": {
    "_postman_id": "b04f5ee9-11ab-4564-b32e-8fb6ec2f2e58",
    "name": "Servicio de Correo Django REST API",
    "description": "Colección para probar los endpoints del microservicio de correos con autenticación por API Key y archivos adjuntos (hasta 10 MB).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "23093066"
  },
  "item": [
    {
      "name": "1. Enviar Correo con Adjunto (form-data)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{api_key}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "recipient",
              "value": "destinatario@ejemplo.com",
              "type": "text"
            },
            {
              "key": "subject",
              "value": "Envío de Documento Adjunto",
              "type": "text"
            },
            {
              "key": "body_html",
              "value": "<h1>Adjunto requerido</h1><p>Se adjunta el archivo solicitado en el correo.</p>",
              "type": "text"
            },
            {
              "key": "attachment",
              "type": "file",
              "value": null
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/emails/send/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "emails",
            "send",
            ""
          ]
        }
      },
      "response": []
    },
