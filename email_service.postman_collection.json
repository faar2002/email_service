	"item": [
		{
			"name": "1. Enviar Correo con Adjunto (form-data)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "X-API-KEY",
						"value": "{{api_key}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "recipient",
							"value": "destinatario@ejemplo.com",
							"type": "text"
						},
						{
							"key": "subject",
							"value": "Envío de Documento Adjunto",
							"type": "text"
						},
						{
							"key": "body_html",
							"value": "<h1>Adjunto requerido</h1><p>Se adjunta el archivo solicitado en el correo.</p>",
							"type": "text"
						},
						{
							"key": "attachment",
							"type": "file",
							"src": []
						}
					]
				},
				"url": {
					"raw": "{{base_url}}/api/v1/emails/send/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"emails",
						"send",
						""
					]
				}
			},
			"response": []
		},
